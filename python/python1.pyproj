    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{340cbe66-0f5b-4b63-b084-aa2ab2996f02}</ProjectGuid>
    <ProjectHome />
    <StartupFile>api.py</StartupFile>
    <SearchPath />
